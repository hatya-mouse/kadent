import std

let channels = {}
let sample_rate = {}
let buffer_size = {}

let seconds_per_sample = 1.0 / std.convert.int_to_float(sample_rate)
// These must be as the same as the number defined in kadent_engine
let max_channels = 64
let max_voices = 16
let max_events = 4

typealias Sample = [Float; 64] // Same as max_channels

func zero_sample() -> Sample {{
    return [0.0; max_channels]
}}

struct Event {{
    // -1 = not set, 0 = note off, 1 = note on
    var type = -1
    // A MIDI note number.
    var pitch = 0.0
    // A MIDI velocity value.
    var velocity = 0.0
}}

struct EventSlot {{
    // An array of events in the slot.
    var events = [Event(); max_events]
    // The number of events in the slot.
    var count = 0
}}

struct Voice {{
    // Whether the voice is currently active.
    var is_active = false
    // A MIDI note number.
    var pitch = 0.0
    // A MIDI velocity value.
    var velocity = 0.0
    // The age of the voice in seconds.
    var age = 0.0
}}

struct Allocator {{
    var voices = [Voice(); max_voices]

    func update(slot: EventSlot) {{
        var i = 0
        loop max_events {{
            let event = slot.events[i]
            if event.type == 1 {{
                self.allocate_voice(event.pitch, event.velocity)
            }} else if event.type == 0 {{
                self.release_voice(event.pitch)
            }}
            i = i + 1
        }}

        i = 0
        loop max_voices {{
            if self.voices[i].is_active {{
                self.voices[i].age = self.voices[i].age + seconds_per_sample
            }}
            i = i + 1
        }}
    }}

    func allocate_voice(pitch: Float, velocity: Float) {{
        var i = 0
        var oldest_index = 0
        var max_age = -1.0

        loop max_voices {{
            if !self.voices[i].is_active {{
                self.voices[i].is_active = true
                self.voices[i].pitch = pitch
                self.voices[i].velocity = velocity
                self.voices[i].age = 0.0
                return
            }}

            if self.voices[i].age > max_age {{
                max_age = self.voices[i].age
                oldest_index = i
            }}
            i = i + 1
        }}

        self.voices[oldest_index].is_active = true
        self.voices[oldest_index].pitch = pitch
        self.voices[oldest_index].velocity = velocity
        self.voices[oldest_index].age = 0.0
    }}

    func release_voice(pitch: Float) {{
        var i = 0
        loop max_voices {{
            if self.voices[i].is_active && self.voices[i].pitch == pitch {{
                self.voices[i].is_active = false
            }}
            i = i + 1
        }}
    }}
}}
